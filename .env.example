# @BotFather'dan olingan token
BOT_TOKEN=123456789:AAExampleTokenReplaceWithYourOwn

# Agent(lar)ning telegram_id'lari, vergul bilan ajratilgan.
# O'z ID'ingizni bilish uchun @userinfobot ga /start yozing.
AGENT_IDS=111111111

# Ro'yxatdan o'tmagan odamga ko'rsatiladigan agent raqami
AGENT_CONTACT_PHONE=+998 88 526 20 03

# Railway'ga deploy qilingandan keyingi domen (masalan: https://suv-bot-production.up.railway.app)
# Bo'sh qoldirilsa вЂ” bot lokal polling rejimida ishlaydi (Mini App API'siz).
WEBHOOK_BASE_URL=

# Mini App ochiladigan URL вЂ” odatda WEBHOOK_BASE_URL bilan bir xil
WEBAPP_URL=

# Telegram webhook so'rovlarini tekshirish uchun maxfiy so'z (o'zingiz o'ylab toping)
WEBHOOK_SECRET=change-this-secret

# Ma'lumotlar bazasi fayli yo'li. Railway'da doimiy volume ulangan bo'lsa,
# masalan: /data/suv_bot.db
DB_PATH=suv_bot.db

# Railway avtomatik beradi, lokal uchun qo'lda ko'rsatish shart emas
PORT=8080
